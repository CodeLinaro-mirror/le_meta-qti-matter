From 2d874079419af617bc15dad2d6b9855f2bfff1e9 Mon Sep 17 00:00:00 2001
From: Xiaogang Wei <quic_xiwei@quicinc.com>
Date: Mon, 5 May 2025 23:43:58 -0700
Subject: [PATCH] add kalama in all clusters app example

Signed-off-by: Xiaogang Wei <quic_xiwei@quicinc.com>
---
 examples/all-clusters-app/qcom/kalama/BUILD.gn | 14 +++++++-------
 examples/all-clusters-app/qcom/kalama/args.gni |  2 +-
 examples/platform/qcom/kalama/AppMain.cpp      |  4 ++++
 examples/platform/qcom/kalama/Options.cpp      |  9 +++++++++
 examples/platform/qcom/kalama/Options.h        |  1 +
 5 files changed, 22 insertions(+), 8 deletions(-)

diff --git a/examples/all-clusters-app/qcom/kalama/BUILD.gn b/examples/all-clusters-app/qcom/kalama/BUILD.gn
index 0e16c64c41d..0d33e7aa5c6 100644
--- a/examples/all-clusters-app/qcom/kalama/BUILD.gn
+++ b/examples/all-clusters-app/qcom/kalama/BUILD.gn
@@ -59,7 +59,7 @@ source_set("chip-all-clusters-common") {
     "${chip_root}/examples/all-clusters-app/all-clusters-common/src/static-supported-modes-manager.cpp",
     "${chip_root}/examples/all-clusters-app/all-clusters-common/src/static-supported-temperature-levels.cpp",
     "${chip_root}/examples/all-clusters-app/all-clusters-common/src/tcc-mode.cpp",
-    "${chip_root}/examples/all-clusters-app/linux/diagnostic-logs-provider-delegate-impl.cpp",
+    "${chip_root}/examples/all-clusters-app/qcom/kalama/diagnostic-logs-provider-delegate-impl.cpp",
     "${chip_root}/examples/energy-management-app/energy-management-common/common/src/EnergyTimeUtils.cpp",
     "${chip_root}/examples/energy-management-app/energy-management-common/device-energy-management/src/DeviceEnergyManagementDelegateImpl.cpp",
     "${chip_root}/examples/energy-management-app/energy-management-common/device-energy-management/src/DeviceEnergyManagementManager.cpp",
@@ -91,7 +91,7 @@ source_set("chip-all-clusters-common") {
 
   deps = [
     "${chip_root}/examples/all-clusters-app/all-clusters-common",
-    "${chip_root}/examples/platform/linux:app-main",
+    "${chip_root}/examples/platform/qcom/kalama:app-main",
     "${chip_root}/src/app/tests/suites/credentials:dac_provider",
     "${chip_root}/src/lib",
     "${chip_root}/third_party/jsoncpp",
@@ -148,7 +148,7 @@ if (is_libfuzzer) {
 
     deps = [
       ":chip-all-clusters-common",
-      "${chip_root}/examples/platform/linux:app-main",
+      "${chip_root}/examples/platform/qcom/kalama:app-main",
     ]
 
     cflags = [ "-Wconversion" ]
@@ -161,7 +161,7 @@ if (is_libfuzzer) {
 
     deps = [
       ":chip-all-clusters-common",
-      "${chip_root}/examples/platform/linux:app-main",
+      "${chip_root}/examples/platform/qcom/kalama:app-main",
     ]
 
     cflags = [ "-Wconversion" ]
@@ -190,7 +190,7 @@ if (is_libfuzzer) {
   }
 }
 
-group("linux") {
+group("qcom/kalama") {
   deps = []
   if (is_libfuzzer) {
     deps += [ ":chip-all-clusters-app-fuzzing" ]
@@ -200,7 +200,7 @@ group("linux") {
 }
 
 group("default") {
-  deps = [ ":linux" ]
+  deps = [ ":qcom/kalama" ]
 }
 
 if (enable_fuzz_test_targets) {
@@ -208,7 +208,7 @@ if (enable_fuzz_test_targets) {
     sources = [ "fuzzing-main.cpp" ]
     public_deps = [
       ":chip-all-clusters-common",
-      "${chip_root}/examples/platform/linux:app-main",
+      "${chip_root}/examples/platform/qcom/kalama:app-main",
     ]
   }
 }
diff --git a/examples/all-clusters-app/qcom/kalama/args.gni b/examples/all-clusters-app/qcom/kalama/args.gni
index 92d01ea3358..7cc29109be0 100644
--- a/examples/all-clusters-app/qcom/kalama/args.gni
+++ b/examples/all-clusters-app/qcom/kalama/args.gni
@@ -21,7 +21,7 @@ chip_project_config_include = "<CHIPProjectAppConfig.h>"
 chip_system_project_config_include = "<SystemProjectConfig.h>"
 
 chip_project_config_include_dirs =
-    [ "${chip_root}/examples/all-clusters-app/linux/include" ]
+    [ "${chip_root}/examples/all-clusters-app/qcom/kalama/include" ]
 chip_project_config_include_dirs += [ "${chip_root}/config/standalone" ]
 
 matter_enable_tracing_support = true
diff --git a/examples/platform/qcom/kalama/AppMain.cpp b/examples/platform/qcom/kalama/AppMain.cpp
index a2e341efbe7..c0e9f8451af 100644
--- a/examples/platform/qcom/kalama/AppMain.cpp
+++ b/examples/platform/qcom/kalama/AppMain.cpp
@@ -475,6 +475,10 @@ int ChipLinuxAppInit(int argc, char * const argv[], OptionSet * customOptions,
 #if CHIP_DEVICE_CONFIG_ENABLE_WPA && CHIP_DEVICE_CONFIG_SUPPORTS_CONCURRENT_CONNECTION
     if (LinuxDeviceOptions::GetInstance().mWiFi)
     {
+        if(LinuxDeviceOptions::GetInstance().Wpa3_mode)
+	{	
+         DeviceLayer::ConnectivityMgrImpl().ConfiugreWpa3(LinuxDeviceOptions::GetInstance().Wpa3_mode);
+	}
         // Start WiFi management in Concurrent mode
         DeviceLayer::ConnectivityMgrImpl().StartWiFiManagement();
         if (!EnsureWiFiIsStarted())
diff --git a/examples/platform/qcom/kalama/Options.cpp b/examples/platform/qcom/kalama/Options.cpp
index 6f8afea5bb4..8e0282536b9 100644
--- a/examples/platform/qcom/kalama/Options.cpp
+++ b/examples/platform/qcom/kalama/Options.cpp
@@ -119,6 +119,7 @@ enum
 #if CHIP_DEVICE_CONFIG_ENABLE_WIFIPAF
     kDeviceOption_WiFi_PAF,
 #endif
+    kDeviceOption_WiFi_WPA3,
 };
 
 constexpr unsigned kAppUsageLength = 64;
@@ -191,6 +192,7 @@ OptionDef sDeviceOptionDefs[] = {
 #if CHIP_WITH_NLFAULTINJECTION
     { "faults", kArgumentRequired, kDeviceOption_FaultInjection },
 #endif
+    { "wifi_wpa3", kArgumentRequired, kDeviceOption_WiFi_WPA3 },
     {}
 };
 
@@ -340,6 +342,8 @@ const char * sDeviceOptionHelp =
     "  --faults <fault-string,...>\n"
     "       Inject specified fault(s) at runtime.\n"
 #endif
+    "  --wifi_wpa3 <SAE = 1 | OWE = 2>\n"
+    "       Configure the wpa3 mode : SAE/OWE.\n"	    
     "\n";
 
 #if CHIP_CONFIG_USE_ACCESS_RESTRICTIONS
@@ -685,6 +689,11 @@ bool HandleOption(const char * aProgram, OptionSet * aOptions, int aIdentifier,
         break;
     }
 #endif
+    case kDeviceOption_WiFi_WPA3: {
+	LinuxDeviceOptions::GetInstance().mWiFi = true;				  
+        LinuxDeviceOptions::GetInstance().Wpa3_mode = static_cast<uint8_t>(strtoul(aValue, nullptr, 0));;
+        break;
+    }	
     default:
         PrintArgError("%s: INTERNAL ERROR: Unhandled option: %s\n", aProgram, aName);
         retval = false;
diff --git a/examples/platform/qcom/kalama/Options.h b/examples/platform/qcom/kalama/Options.h
index 11a9061efca..df7f4340ce0 100644
--- a/examples/platform/qcom/kalama/Options.h
+++ b/examples/platform/qcom/kalama/Options.h
@@ -92,6 +92,7 @@ struct LinuxDeviceOptions
     chip::Optional<std::vector<chip::Access::AccessRestrictionProvider::Entry>> arlEntries;
 #endif
     static LinuxDeviceOptions & GetInstance();
+    uint8_t Wpa3_mode = 0;
 };
 
 CHIP_ERROR ParseArguments(int argc, char * const argv[], chip::ArgParser::OptionSet * customOptions = nullptr);
-- 
2.34.1

