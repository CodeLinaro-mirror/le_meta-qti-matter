+void adapterGattsCallback::onConnectionStateChange(string deviceAddress, int status,
+                                                               int newState)
+{
+    static uint8_t devIdx = 1;
+  ALOGD(LOGTAG"%s status = %d newState = %d", __FUNCTION__ , status , newState);
+  ALOGD(LOGTAG"%s device address: %s",__FUNCTION__, deviceAddress.c_str());
+  if (newState == GattDevice::STATE_CONNECTED) {
+      if (status == GattClient::GATT_SUCCESS) {
+        mgattServer->connect(deviceAddress,AUTO_CONNECT);
+        auto it = connectedDeviceMap.find(deviceAddress);
+        if (it == connectedDeviceMap.end()) {
+            connectedDeviceMap[deviceAddress] = devIdx++;
+        }
+
+        uint16_t connId = connectedDeviceMap[deviceAddress];
+        chip::DeviceLayer::Internal::BLEManagerImpl::HandleNewConnection(static_cast<BLE_CONNECTION_OBJECT>(connId));
+      }
+      else {
+          chip::DeviceLayer::Internal::BLEManagerImpl::HandleConnectFailed(CHIP_ERROR_INTERNAL);
+    }
+  } else if(newState == GattDevice::STATE_DISCONNECTED) {
+    auto it = connectedDeviceMap.find(deviceAddress);
+    if (it != connectedDeviceMap.end()) {
+        chip::DeviceLayer::Internal::BLEManagerImpl::HandleConnectionClosed(it->second); // CHIPoBleConnectionClosed--> HandleConnectionClosed
+        connectedDeviceMap.erase(it);
+    }
+  }
+}
