+void AdapterMain::AddMatterService()
+{
+  Uuid  temp_UUID;
+  string uid;
+  GattService *mService = NULL;
+  string desc_val = "DESC";
+
+  ALOGD(LOGTAG"%s",__FUNCTION__);
+  ALOGD(LOGTAG"Adding Matter Server Instance");
+  if (mgattServer == NULL) {
+    mgattServer = new GattServer(g_gatt,GattDevice::TRANSPORT_LE);
+    ALOGD(LOGTAG"Adding Matter Server CallBack");
+    adapterGattsCallback *adapterGattsCb = new adapterGattsCallback();
+    mgattServer->registerCallback(*adapterGattsCb);
+    ALOGD(LOGTAG"Adding Advertiser Callback");
+    adapterAdvCb    = new adapterAdvertiserCallback();
+
+
+    temp_UUID = Uuid::FromString(UUID16_CHIPoBLEService);
+    mService  = new GattService(temp_UUID,GattService::SERVICE_TYPE_PRIMARY);
+    temp_UUID = Uuid::FromString(UUID16_CHIPoBLECharacteristic_1);
+    GattCharacteristic *chr = AddCharacteristics(temp_UUID, GattCharacteristic::PROPERTY_WRITE,
+            GattCharacteristic::PERMISSION_READ|GattCharacteristic::PERMISSION_WRITE, "0x08");
+    mService->addCharacteristic(chr);
+    uint8_t permissions = GattCharacteristic::PERMISSION_READ|GattCharacteristic::PERMISSION_WRITE;
+    temp_UUID = Uuid::FromString(UUID16_CHIPoBLECharacteristic_2);
+    chr = AddCharacteristics(temp_UUID, GattCharacteristic::PROPERTY_READ|GattCharacteristic::PROPERTY_INDICATE,
+            GattCharacteristic::PERMISSION_READ|GattCharacteristic::PERMISSION_WRITE, "0x0a");
+    temp_UUID = Uuid::FromString("2902");
+    GattDescriptor *desp = AddDescriptors(temp_UUID,permissions,desc_val);
+    chr->addDescriptor(desp);
+    mService->addCharacteristic(chr);
+    mgattServer->addService(*mService);
+  }
+}
