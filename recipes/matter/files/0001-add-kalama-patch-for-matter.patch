+bool AdapterMain::StartBLEAdvertising(uint8_t mode, bool connectable, uint32_t duration, string uuid)
+{
+    ALOGD(LOGTAG"%s",__FUNCTION__);
+    bool status = false;
+    status = BuildAdvertisingParameters(mode, connectable, duration);
+    if(!status) {
+        ALOGD(LOGTAG "Advertising Parameters not set \n");
+        return false;
+    }
+    status = BuildAdvertisingData(uuid);
+    if(!status) {
+        fprintf(stdout,"Advertising Data not set \n");
+        return false;
+    }
+
+    ALOGD(LOGTAG"Legacy StartAdvertisement");
+    madvertiser->startAdvertising(mAdvertiseSettings, mAdvertiseData, mAdvertiseData, adapterAdvCb);
+    return true;
+}
+
+bool AdapterMain::BuildAdvertisingParameters(uint8_t mode, bool connectable, uint32_t duration)
+{
+    /* set adv paramter */
+    if (mAdvertiseSettings != NULL) {
+        delete mAdvertiseSettings;
+    }
+    ALOGD(LOGTAG" Legacy Advertising will be used \n");
+
+    mAdvertiseSettings = AdvertiseSettings::Builder()
+                         .setAdvertiseMode(mode)
+                         //.setTxPowerLevel(setParams->tx_power)
+                         .setConnectable(connectable)
+                         .setTimeout(duration)
+                         .build();
+
+    ALOGD(LOGTAG"Advertising Settings connectable = %d \
+          TxPowerLevel = %d AdvertiseMode =%d TimeOut = %d",
+          mAdvertiseSettings->isConnectable(),
+          mAdvertiseSettings->getTxPowerLevel(), mAdvertiseSettings->getMode(),
+          mAdvertiseSettings->getTimeout());
+    return true;
+}
+
+bool AdapterMain::BuildAdvertisingData(string service_data_uuid)
+{
+  string service1_uuid;
+  string service_data= "CHIP";
+  Uuid mUuid;
+  ALOGD(LOGTAG"%s",__FUNCTION__);
+  if (mAdvertiseData != NULL) {
+      delete mAdvertiseData;
+  }
+
+  chip::Ble::ChipBLEDeviceIdentificationInfo deviceIdInfo;
+  CHIP_ERROR err = chip::DeviceLayer::ConfigurationMgr().GetBLEDeviceIdentificationInfo(deviceIdInfo);
+  if (err != CHIP_NO_ERROR) {
+      return false;
+  }
+
+  uint8_t char_val[sizeof(deviceIdInfo)];
+  memcpy(char_val, &deviceIdInfo, sizeof(deviceIdInfo));
+
+  AdvertiseData::Builder builder = AdvertiseData::Builder().setIncludeDeviceName(true);
+  mUuid = Uuid::FromString(service_data_uuid);
+  //builder.addServiceUuid(mUuid);
+  mUuid = Uuid::FromString(service_data_uuid);
+  std::vector<uint8_t> vec(char_val, char_val + sizeof(deviceIdInfo));
+  builder.addServiceData(mUuid,vec);
+  mAdvertiseData = builder.build();
+  ALOGD(LOGTAG"AdvertiseData IncludeDevicename: %d ", mAdvertiseData->getIncludeDeviceName());
+  ALOGD(LOGTAG"serviceData size:  %d", mAdvertiseData->getServiceData().size());
+  ALOGD(LOGTAG"uuid:  %s", service_data_uuid.c_str());
+  return true;
+}
