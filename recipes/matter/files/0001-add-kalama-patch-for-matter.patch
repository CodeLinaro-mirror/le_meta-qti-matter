+
+CHIP_ERROR BLEManagerImpl::_StartBLEAdvertising()
+{
+    ChipLogProgress(DeviceLayer, "BLEManagerImpl::_StartBLEAdvertising");
+    bool ret;
+    ret = StartBLEAdvertising(true, mBLEAdvConfig.mAdvMode, mBLEAdvConfig.connectableflag,
+                              mBLEAdvConfig.mDuration, mBLEAdvConfig.mpAdvertisingUUID);
+    if (mFlags.Has(Flags::kFastAdvertisingEnabled))
+    {
+        DeviceLayer::SystemLayer().StartTimer(kFastAdvertiseTimeout, _ReconfigureBLEAdvertising, mpEndpoint);
+    }
+    return CHIP_NO_ERROR;
+}
+
+CHIP_ERROR BLEManagerImpl::_StopBLEAdvertising()
+{
+    ChipLogProgress(DeviceLayer, "BLEManagerImpl::_StopBLEAdvertising");
+    bool ret;
+    ret = StartBLEAdvertising(false, mBLEAdvConfig.mAdvMode, mBLEAdvConfig.connectableflag,
+                               mBLEAdvConfig.mDuration, mBLEAdvConfig.mpAdvertisingUUID);
+    DeviceLayer::SystemLayer().CancelTimer(_ReconfigureBLEAdvertising, mpEndpoint);
     return CHIP_NO_ERROR;
 }
 
+void BLEManagerImpl::_ReconfigureBLEAdvertising(chip::System::Layer *, void * apEndpoint)
+{
+    ChipLogProgress(DeviceLayer, "BLEManagerImpl::_ReconfigureBLEAdvertising");
+    bool ret;
+    sInstance._SetAdvertisingMode(BLEAdvertisingMode::kSlowAdvertising);
+}
