+bool StartBLEAdvertising(bool val, uint8_t mode, bool connectable, uint32_t duration, string uuid)
+{
+  ALOGD(LOGTAG " StartBLEAdvertising");
+    if (g_adapter == NULL) {
+        ALOGE(LOGTAG " Adapter is OFF");
+        return false;
+    }
+    if (val) {
+        return g_adapter->StartBLEAdvertising(mode, connectable, duration, uuid);
+    }
+    else {
+        g_adapter->StopAdvertisement();
+        return true;
+    }
+}
