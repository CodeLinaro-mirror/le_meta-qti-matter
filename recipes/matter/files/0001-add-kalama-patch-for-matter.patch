+GattCharacteristic * AdapterMain::AddCharacteristics(Uuid uid,int property, int permissions, string val)
+{
+  ALOGD(LOGTAG"%s",__FUNCTION__);
+  GattCharacteristic  *gattCharacteristic = new GattCharacteristic(uid,property,permissions);
+  uint8_t char_val[val.length()+1];
+  std::copy(val.begin(),val.end(),char_val);
+  gattCharacteristic->setValue(char_val, val.length() + 1);
+  ALOGD(LOGTAG"CharacteristicUUID: %s  ", uid.ToString().c_str());
+  ALOGD(LOGTAG"Characteristic Property: %d ", gattCharacteristic->getProperties());
+  ALOGD(LOGTAG"characteristic Permissions: %d ", gattCharacteristic->getPermissions());
+  ALOGD(LOGTAG"characteristic value: %s", gattCharacteristic->getValue());
+  return gattCharacteristic;
+}
+
+GattDescriptor *AdapterMain::AddDescriptors(Uuid uid,int permissions,string value)
+{
+  ALOGD(LOGTAG"%s",__FUNCTION__);
+  ALOGD(LOGTAG"string value =  %s", value.c_str());
+  GattDescriptor *desp = new GattDescriptor(uid,permissions);
+  uint8_t dsc_val[value.length()+1];
+  std::copy(value.begin(),value.end(),dsc_val);
+  desp->setValue(dsc_val, value.length() + 1);
+  ALOGD(LOGTAG"Descriptor UUID: %s  ", uid.ToString().c_str());
+  ALOGD(LOGTAG"Descriptor Permissions: %d ", desp->getPermissions());
+  return desp;
+}
