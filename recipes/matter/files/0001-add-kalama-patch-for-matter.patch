+inline config_t * initChipConfig()
+{
+    config_t * config = config_new (CONFIG_FILE_PATH);
+    if (NULL == config) {
+        ALOGE (LOGTAG " config file does not exist, generate a default one");
+        config = config_new_empty();
+        config_set_string(config, CONFIG_DEFAULT_SECTION, "BtLocalDeviceName", CONFIG_DEFAULT_DEVICE_NAME);
+        config_save(config, CONFIG_FILE_PATH);
+    } else {
+        ALOGE(LOGTAG "read config file, dev name is %s", config_get_string(config, CONFIG_DEFAULT_SECTION, "BtLocalDeviceName", "MDM"));
+    }
+    return config;
+}
+
+void InitHandler(void)
+{
+    config_t * config = initChipConfig();
+    if (NULL == config) {
+        ALOGE (LOGTAG " Error in Loading config file");
+    }
+
+    if (!LoadBtStack()) {
+        return;
+    }
+    // Starting GAP Thread
+    threadInfo[THREAD_ID_GAP].thread_id = thread_new (
+            threadInfo[THREAD_ID_GAP].thread_name);
+
+    if (threadInfo[THREAD_ID_GAP].thread_id) {
+        g_gap = new Gap (bt_interface, config);
+    }
+
+    threadInfo[THREAD_ID_SDP_CLIENT].thread_id = thread_new (
+            threadInfo[THREAD_ID_SDP_CLIENT].thread_name);
+
+    ALOGV (LOGTAG "  Starting GATT thread");
+    threadInfo[THREAD_ID_GATT].thread_id = thread_new (
+            threadInfo[THREAD_ID_GATT].thread_name);
+
+    if (threadInfo[THREAD_ID_GATT].thread_id) {
+        g_gatt = GattLibService::getInstance(bt_interface);
+    }
+
+    BtEvent *event = new BtEvent;
+    event->event_id = GAP_API_ENABLE;
+    PostMessage (THREAD_ID_GAP, event);
+}
+
+
+void DeInitHandler (void) {
+    ALOGI (LOGTAG " DeInitHandler");
+
+    // Stop GAP Thread
+    if (threadInfo[THREAD_ID_GAP].thread_id != NULL) {
+        thread_free (threadInfo[THREAD_ID_GAP].thread_id);
+        if ( g_gap != NULL)
+            delete g_gap;
+    }
+    ALOGI (LOGTAG " free gap done");
+
+    if (threadInfo[THREAD_ID_GATT].thread_id != NULL){
+        thread_free(threadInfo[THREAD_ID_GATT].thread_id);
+        if (g_gatt != NULL)
+            delete g_gatt;
+    }
+    ALOGI (LOGTAG " free gatt done");
+
+    // Stop SDP Client Thread
+    if (threadInfo[THREAD_ID_SDP_CLIENT].thread_id != NULL) {
+        thread_free (threadInfo[THREAD_ID_SDP_CLIENT].thread_id);
+    }
+    ALOGI (LOGTAG " free sdp done");
+
+    if (threadInfo[THREAD_ID_MAIN].thread_id != NULL){
+        thread_free(threadInfo[THREAD_ID_MAIN].thread_id);
+    }
+    ALOGI (LOGTAG " free main done");
+
+    if(g_gap && g_gap->IsEnabled()) {
+        // SendDisableCmdToGap();
+
+        ALOGI (LOGTAG " unloading BT stack");
+        UnLoadBtStack ();
+    }
+    ALOGI (LOGTAG " unload BT stack done");
+}
