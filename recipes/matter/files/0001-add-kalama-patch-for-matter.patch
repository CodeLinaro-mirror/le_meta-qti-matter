+void BtMainMsgHandler (void *context) {
+    BtEvent *event = NULL;
+    if (!context) {
+        ALOGI (LOGTAG " Msg is null, return.\n");
+        return;
+    }
+    event = (BtEvent *) context;
+
+    ALOGI (LOGTAG " %s: event_id: %d.\n", __func__,  event->event_id);
+    switch (event->event_id) {
+        case MAIN_API_INIT:
+        {
+            InitHandler();
+            break;
+        }
+        case MAIN_API_DEINIT:
+        {
+            DeInitHandler();
+            break;
+        }
+        case MAIN_EVENT_ENABLED:
+        {
+            bt_state = event->state_event.status;
+            if (event->state_event.status == BT_STATE_OFF) {
+                ALOGD(LOGTAG " Error in Enabling BT\n");
+            } else {
+              ALOGD (LOGTAG " BT State is ON : %d",event->state_event.status);
+              g_adapter = new AdapterMain(g_gatt);
+              if (g_adapter != NULL) {
+                  g_adapter->AddMatterService();
+                  chip::DeviceLayer::Internal::BLEManagerImpl::NotifyBLEPeripheralAdvConfiguredComplete(CHIP_NO_ERROR);
+                  //chip::DeviceLayer::Internal::BLEManagerImpl::NotifyBLEPeripheralAdvConfiguredComplete(true, nullptr);
+              }
+            }
+            break;
+        }
+
+        case MAIN_EVENT_DISABLED:
+        {
+            bt_state = event->state_event.status;
+            if (event->state_event.status == BT_STATE_ON) {
+                ALOGD(LOGTAG " Error in Disabling BT\n");
+            } else {
+                // clear the inquiry related cmds
+                // clearing bond_devices list and inquiry_list
+                connectedDeviceMap.clear();
+                system("killall -KILL wcnssfilter");
+                usleep(200);
+                ALOGD (LOGTAG " BT State is OFF : %d",bt_state);
+            }
+            ALOGD (LOGTAG " MAIN_EVENT_DISABLED");
+        }
+        break;
+        default:
+            break;
+    }
+}
